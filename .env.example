# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5         # e.g. claude-sonnet-5-5 or claude-haiku-5-5 for lower cost/latency
# CLAUDE_EFFORT=low                    # low | medium | high
# ENABLE_FALLBACK=1                    # server-side refusal fallback (Claude API only)
# AGENT_REFERENCE_DATE=2026-03-20      # freeze "today" (YYYY-MM-DD) for reproducible demos
# AGENT_DB_PATH=data/runtime/conversations.db
